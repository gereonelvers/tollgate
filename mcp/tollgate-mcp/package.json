{
  "name": "@agents402/mcp",
  "version": "0.2.0",
  "description": "MCP server that lets an AI agent pay for L402 paid actions over Lightning. Includes in-band wallet setup (paste NWC or open browser to create a self-custodial Spark wallet) and decentralized Nostr-based service reputation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gereonelvers/tollgate.git",
    "directory": "mcp/tollgate-mcp"
  },
  "homepage": "https://agents402.org",
  "type": "module",
  "bin": {
    "agents402-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "tsc -p ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@buildonspark/spark-sdk": "^0.7.15",
    "@getalby/sdk": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.0.0",
    "nanoid": "^5.0.0",
    "nostr-tools": "^2.23.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
