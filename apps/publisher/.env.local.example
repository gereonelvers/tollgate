# Tollgate publisher — copy to .env.local and fill in.

# REQUIRED: NWC URL of the wallet that will RECEIVE payments (publisher).
# Format: nostr+walletconnect://...
# Get one from https://getalby.com → Connections → Add connection.
# Permissions needed: make_invoice, lookup_invoice.
PUBLISHER_NWC_URL=

# Public URL of the publisher (used in manifest endpoints).
PUBLISHER_BASE_URL=http://localhost:3000

# Optional: shows up in the manifest, used for receipts.
PUBLISHER_LIGHTNING_ADDRESS=

# Used to sign L402 tokens (any random string is fine; rotate to invalidate all outstanding tokens).
L402_SECRET=dev-secret-change-me-please

# Optional: enables real LLM-backed site_agent answers. If unset, falls back to deterministic snippet selection.
ANTHROPIC_API_KEY=
