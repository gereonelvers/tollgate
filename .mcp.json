{
  "mcpServers": {
    "faregate": {
      "command": "node",
      "args": ["./mcp/tollgate-mcp/dist/index.js"],
      "env": {
        "AGENT_NWC_URL": "${AGENT_NWC_URL}",
        "FAREGATE_POLICY_PATH": "${FAREGATE_POLICY_PATH:-}",
        "FAREGATE_DATA_DIR": "${FAREGATE_DATA_DIR:-}",
        "TOLLGATE_POLICY_PATH": "${TOLLGATE_POLICY_PATH:-}",
        "TOLLGATE_DATA_DIR": "${TOLLGATE_DATA_DIR:-}"
      }
    }
  }
}
